# Copy this file to .env and fill in the values.

# Django backend URL (no trailing slash)
VITE_REACT_BASE_URL=http://127.0.0.1:8005

# Stripe price used if the backend returns no plans
VITE_PRICE_ID=price_...

# Google OAuth web client ID (must also be in the backend's GOOGLE_CLIENT_IDS)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Separate AI service used by Work Flow search and the Offer Library
VITE_AI_BACKEND=https://your-ai-service.example.com
